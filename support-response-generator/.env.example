# Optional: an LLM is NOT needed for the n-gram suggester.
# It is only used by `python -m app.cli polish` to tidy a finished draft.
# Pick one provider (OpenAI-compatible endpoints).

# --- Ollama on your laptop ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# --- Groq (free key: https://console.groq.com) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=your-groq-key

# --- Gemini (free key: https://aistudio.google.com) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-gemini-key
