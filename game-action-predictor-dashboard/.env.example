# The predictor runs fully offline. An LLM is optional and only used by
# `python -m app.cli explain` to narrate a prediction in plain English.
# Pick one provider (OpenAI-compatible endpoints).

# --- Ollama on your laptop ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# --- Groq (free key: https://console.groq.com) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=your-groq-key

# --- Gemini (free key: https://aistudio.google.com) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-gemini-key

# Base model for continued pretraining (any Hugging Face causal LM).
# BASE_MODEL=gpt2
