# The sorter runs fully offline with a fine-tuned GPT-2. No API key needed.
# These settings are optional.

# Base model to fine-tune (any GPT-2-family checkpoint on Hugging Face).
# BASE_MODEL=openai-community/gpt2

# Where the fine-tuned model is written and read.
# MODEL_DIR=models/sorter

# cpu or cuda (defaults to cuda when available).
# DEVICE=cpu
