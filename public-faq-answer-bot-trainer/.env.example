# The FAQ bot runs a GPT-2 model on your own laptop. No API key is needed.
# Copy this file to .env to change the defaults.

# Pre-trained model the LoRA adapter is trained on (a Hugging Face id or a local path).
# BASE_MODEL=openai-community/gpt2

# Where the adapter, merged model and reports are written and read.
# MODEL_DIR=models

# cpu or cuda (defaults to cuda when available).
# DEVICE=cpu
